    {
      "id": "precalculus-3-13-q07",
      "topicId": "precalculus-3-13",
      "concept": "polar-coordinates",
      "difficulty": "Core",
      "skill": "describe",
      "prompt": "A point has polar coordinates (−4, 2π/3). How far is the point from the origin, and in which quadrant does it lie?",
      "choices": [
        "4 units, in Quadrant II",
        "−4 units, in Quadrant II",
        "2 units, in Quadrant IV",
        "4 units, in Quadrant IV"
      ],
      "correctAnswer": 3,
      "explanation": "Distance is |r| = 4. The ray of 2π/3 points into Quadrant II, and the negative r sends the point the opposite way, into Quadrant IV: (2, −2√3).",
      "sourceIds": [
