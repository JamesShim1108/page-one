      "id": "precalculus-3-11-q01",
      "topicId": "precalculus-3-11",
      "concept": "secant-and-cosecant",
      "difficulty": "Quick check",
      "skill": "apply-results",
      "prompt": "What is the value of sec(π/3)?",
      "choices": [
        "1/2",
        "2√3/3",
        "2",
        "√3"
      ],
      "correctAnswer": 2,
      "explanation": "sec(π/3) = 1/cos(π/3) = 1/(1/2) = 2.",
      "sourceIds": [
        "ced",
        "ced-topic-3-11"
      ],
      "choiceExplanations": [
        "1/2 is cos(π/3); secant is its reciprocal.",
        "2√3/3 = 1/(√3/2) is csc(π/3), the reciprocal of sine.",
        "The reciprocal of cos(π/3) = 1/2.",
        "√3 is tan(π/3)."
      ],
      "nearMissIndex": 0,
      "distinguisher": "Secant goes with cosine.",
      "skillLabel": "Apply results in context",
      "skillCode": "3.B"
    },
    {
