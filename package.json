{
  "name": "page-one",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-content.mjs && node scripts/stamp-release.mjs",
    "validate": "node scripts/build-content.mjs --check && node scripts/stamp-release.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate && npm test && npm run format:check",
    "image": "node scripts/prepare-image.mjs",
    "stamp": "node scripts/stamp-release.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "postcss": "^8.5.0",
    "sharp": "^0.34.0"
  }
}
